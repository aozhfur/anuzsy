{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#anu-diploma","title":"\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08ANU Diploma\uff09\u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u91cd\u6784\uff1a\u5f15\u9886\u5168\u7403\u6570\u5b57\u5316\u5b66\u4f4d\u8ba4\u8bc1\u7684\u65b0\u6807\u51c6","text":"<p>\u5728\u5f53\u4eca\u5168\u7403\u6570\u5b57\u5316\u8f6c\u578b\u7684\u6d6a\u6f6e\u4e2d\uff0c\u4f20\u7edf\u7eb8\u8d28\u9ad8\u7b49\u6559\u80b2\u8bc1\u4e66\u6b63\u7ecf\u5386\u7740\u4e00\u573a\u524d\u6240\u672a\u6709\u7684\u6280\u672f\u4e0e\u7f8e\u5b66\u9769\u547d\u3002\u4f5c\u4e3a\u5168\u7403\u9876\u5c16\u7684\u7814\u7a76\u578b\u5927\u5b66\uff0c\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\uff08The Australian National University, \u7b80\u79f0 ANU\uff09\u5728\u6bd5\u4e1a\u8bc1\u4e66\uff08ANU Diploma\uff09\u7684\u8bbe\u8ba1\u3001\u53d1\u653e\u4e0e\u9a8c\u8bc1\u4e0a\uff0c\u7387\u5148\u5b9e\u73b0\u4e86\u4ece\u4f20\u7edf\u5b9e\u7269\u5230\u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u91cd\u6784\u7684\u8de8\u8d8a\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u6df1\u5ea6\u89e3\u6790 ANU \u6bd5\u4e1a\u8bc1\u5982\u4f55\u901a\u8fc7\u6570\u5b57\u5316\u751f\u6001\u6280\u672f\uff0c\u5728\u4fdd\u969c\u5b66\u672f\u4e25\u8083\u6027\u7684\u540c\u65f6\uff0c\u91cd\u5851\u5176\u7248\u5f0f\u7f8e\u5b66\u3001\u9632\u4f2a\u5b89\u5168\u4e0e\u5168\u7403\u6d41\u901a\u4ef7\u503c\u3002</p>"},{"location":"#anu-diploma_1","title":"\u4e00\u3001 ANU Diploma \u6570\u5b57\u5316\u7248\u5f0f\u91cd\u6784\u7684\u65f6\u4ee3\u80cc\u666f\u4e0e\u6838\u5fc3\u8bf1\u56e0","text":""},{"location":"#1","title":"1. \u4f20\u7edf\u6d77\u5916\u5b66\u5386\u9a8c\u8bc1\u7684\u75db\u70b9","text":"<p>\u957f\u671f\u4ee5\u6765\uff0c\u8de8\u56fd\u6c42\u804c\u548c\u6d77\u5916\u6df1\u9020\u7684\u5b66\u5b50\u5728\u5b66\u5386\u8ba4\u8bc1\u4e0a\u9762\u4e34\u8bf8\u591a\u4e0d\u4fbf\u3002\u7eb8\u8d28\u6bd5\u4e1a\u8bc1\u6613\u635f\u574f\u3001\u6613\u4e22\u5931\uff0c\u4e14\u4f20\u7edf\u7684\u8de8\u5883\u4eba\u5de5\u6838\u9a8c\u5468\u671f\u957f\u3001\u6210\u672c\u9ad8\u3002\u6b64\u5916\uff0c\u56fd\u9645\u6587\u51ed\u9020\u5047\u9ed1\u8272\u4ea7\u4e1a\u94fe\u7684\u7316\u7357\uff0c\u4e5f\u5bf9\u9ad8\u6821\u7684\u54c1\u724c\u4fe1\u8a89\u6784\u6210\u4e86\u4e25\u5cfb\u6311\u6218\u3002</p>"},{"location":"#2","title":"2. \u5168\u7403\u6570\u5b57\u4fe1\u4efb\u4f53\u7cfb\u7684\u5d1b\u8d77","text":"<p>\u968f\u7740 MyeQuals \u7b49\u5b98\u65b9\u6570\u5b57\u5316\u51ed\u8bc1\u5e73\u53f0\u7684\u666e\u53ca\uff0c\u6fb3\u6d32\u9ad8\u7b49\u6559\u80b2\u5168\u9762\u8fdb\u5165\u6570\u5b57\u539f\u751f\u65f6\u4ee3\u3002\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\uff08ANU\uff09\u4f5c\u4e3a\u884c\u4e1a\u6807\u6746\uff0c\u654f\u9510\u5730\u610f\u8bc6\u5230\uff1a\u6570\u5b57\u5316\u4e0d\u53ea\u662f\u7b80\u5355\u5730\u5c06\u7eb8\u8d28\u8bc1\u4e66\u626b\u63cf\u6210 PDF\uff0c\u800c\u662f\u9700\u8981\u5bf9\u8bc1\u4e66\u7684\u4fe1\u606f\u5c42\u7ea7\u3001\u89c6\u89c9\u7248\u5f0f\u548c\u5e95\u5c42\u4fe1\u4efb\u903b\u8f91\u8fdb\u884c\u751f\u6001\u5316\u7684\u5168\u65b9\u4f4d\u91cd\u6784\u3002</p>"},{"location":"#_1","title":"\u4e8c\u3001 \u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u7684\u4e09\u5927\u91cd\u6784\u6838\u5fc3\uff1a\u7f8e\u5b66\u3001\u7ed3\u6784\u4e0e\u9632\u4f2a","text":"<p>\u4ece\u89c6\u89c9\u5448\u73b0\u4e0e\u6280\u672f\u5e95\u5c42\u6765\u770b\uff0c\u6570\u5b57\u5316\u7684 ANU \u6bd5\u4e1a\u8bc1\uff08\u5982\u4e0a\u56fe\u6240\u793a\u6837\u4f8b\uff09\u4e0d\u4ec5\u7ee7\u627f\u4e86\u767e\u5e74\u540d\u6821\u7684\u5e84\u4e25\u611f\uff0c\u66f4\u878d\u5165\u4e86\u73b0\u4ee3\u6570\u5b57\u8bbe\u8ba1\u7684\u6781\u7b80\u4e3b\u4e49\u4e0e\u5b89\u5168\u7279\u6027\u3002</p> <pre><code>+---------------------------------------------------------+\n\n|        VALID ONLY FOR ONLINE VIEWING AT MyeQuals        |\n|                                                         |\n|    [ANU LOGO]      Australian National University       |\n|                                                         |\n|                  THIS IS TO CERTIFY THAT                |\n|                      [STUDENT NAME]                     |\n|                                                         |\n|               HAS BEEN AWARDED THE DEGREE OF            |\n|                     Bachelor of Finance                 |\n|                                                         |\n|    GIVEN UNDER THE SEAL ON THE 28TH DAY OF JULY 2026    |\n|                                                         |\n|     (RED SEAL)                    [CHANCELLOR SIGN]     |\n|                                   [VICE-CHANCELLOR SIGN]|\n+---------------------------------------------------------+\n</code></pre>"},{"location":"#1-dynamic-headerfooter","title":"1. \u9876\u90e8\u4e0e\u5e95\u90e8\uff1a\u52a8\u6001\u6570\u5b57\u751f\u6001\u9875\u7709\uff08Dynamic Header/Footer\uff09","text":"<p>\u6570\u5b57\u5316\u7248\u5f0f\u6700\u663e\u8457\u7684\u7279\u5f81\u5728\u4e8e\u5176\u5916\u56f4\u7684\u201c\u6570\u5b57\u751f\u6001\u6846\u67b6\u201d\u3002\u5728\u8bc1\u4e66\u7684\u6781\u9876\u4e0e\u6781\u5e95\uff0c\u6e05\u6670\u6807\u6ce8\u4e86 \"VALID ONLY FOR ONLINE VIEWING AT https://www.myequals.net\"\uff08\u4ec5\u9650\u5728 MyeQuals \u5728\u7ebf\u67e5\u770b\u65f6\u6709\u6548\uff09\u3002\u8fd9\u4e00\u8bbe\u8ba1\u5c06\u539f\u672c\u5b64\u7acb\u7684\u8bc1\u4e66\uff0c\u76f4\u63a5\u951a\u5b9a\u5728\u5168\u7403\u4e92\u8ba4\u7684\u6570\u5b57\u4fe1\u4efb\u7f51\u7edc\u4e2d\u3002</p>"},{"location":"#2_1","title":"2. \u89c6\u89c9\u9ec4\u91d1\u5206\u5272\u4e0e\u4fe1\u606f\u964d\u566a","text":"<ul> <li>\u6821\u5fbd\u4e0e\u6821\u540d\uff08Brand Identity\uff09\uff1a \u9876\u90e8\u5c45\u4e2d\u7559\u767d\uff0c\u4fdd\u7559\u4e86 ANU \u7ecf\u5178\u7684\u76fe\u5fbd\u4e0e\u91d1\u8272\u6ce2\u7eb9\u8bbe\u8ba1\uff0c\u5f70\u663e\u6fb3\u6d32\u7b2c\u4e00\u5b66\u5e9c\u7684\u5b66\u672f\u5a01\u4e25\u3002</li> <li>\u6838\u5fc3\u6587\u672c\u653e\u5927\uff08Core Typography\uff09\uff1a \u6452\u5f03\u4e86\u8fc7\u53bb\u7e41\u590d\u7684\u82b1\u4f53\u5b57\uff0c\u6838\u5fc3\u5b66\u4f4d\u540d\u79f0\uff08\u5982 Bachelor of Finance\uff09\u91c7\u7528\u9ad8\u5bf9\u6bd4\u5ea6\u7684\u73b0\u4ee3\u65e0\u886c\u7ebf\u5b57\u4f53\uff0c\u5b57\u53f7\u663e\u8457\u653e\u5927\u3002\u8fd9\u79cd\u8bbe\u8ba1\u786e\u4fdd\u4e86\u5728\u667a\u80fd\u624b\u673a\u3001\u5e73\u677f\u7535\u8111\u53ca\u7535\u8111\u663e\u793a\u5668\u4e0a\uff0c\u96c7\u4e3b\u548c\u8ba4\u8bc1\u673a\u6784\u80fd\u57280.5\u79d2\u5185\u7cbe\u51c6\u6355\u6349\u6838\u5fc3\u4fe1\u606f\u3002</li> </ul>"},{"location":"#3-digital-red-seal","title":"3. \u6570\u5b57\u590d\u523b\u7ea2\u5370\uff08Digital Red Seal\uff09\u4e0e\u52a8\u6001\u7b7e\u540d","text":"<p>\u4f4d\u4e8e\u5de6\u4e0b\u89d2\u7684\u6807\u5fd7\u6027\u94a2\u5370\uff08Seal\uff09\u5728\u6570\u5b57\u5316\u7248\u5f0f\u4e2d\u88ab\u8f6c\u5316\u4e3a\u9ad8\u5206\u8fa8\u7387\u7684\u77e2\u91cf\u56fe\u5c42\uff0c\u8fb9\u7f18\u9510\u5229\uff0c\u5373\u4fbf\u57284K\u5c4f\u5e55\u4e0a\u65e0\u9650\u653e\u5927\u4e5f\u4e0d\u4f1a\u6a21\u7cca\u3002\u53f3\u4fa7\u5219\u7559\u7ed9\u6559\u52a1\u957f\uff08Chancellor\uff09\u4e0e\u526f\u6821\u957f\uff08Vice-Chancellor\uff09\u7684\u7535\u5b50\u7b7e\u540d\uff0c\u5b9e\u73b0\u4e86\u4f20\u7edf\u5b66\u672f\u4eea\u5f0f\u611f\u4e0e\u6570\u5b57\u6548\u7387\u7684\u5b8c\u7f8e\u878d\u5408\u3002</p>"},{"location":"#anu","title":"\u4e09\u3001 ANU \u6570\u5b57\u5316\u6bd5\u4e1a\u8bc1\u7684\u5e95\u5c42\u6280\u672f\uff1a\u5982\u4f55\u5b9e\u73b0\u201c\u4e0d\u53ef\u7be1\u6539\u201d","text":"<p>\u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u91cd\u6784\u7684\u5185\u6838\u662f\u5b89\u5168\u9632\u4f2a\u6280\u672f\u3002\u4e00\u5f20\u770b\u4f3c\u7b80\u5355\u7684\u6570\u5b57\u8bc1\u4e66\uff0c\u5176\u80cc\u540e\u4ea4\u7ec7\u7740\u591a\u91cd\u6570\u5b57\u9632\u5fa1\u7f51\u7edc\uff1a</p> <ul> <li>\u52a0\u5bc6\u54c8\u5e0c\u7b97\u6cd5\uff08Cryptographic Hashing\uff09\uff1a \u6bcf\u4e00\u4efd\u7531 ANU \u5b98\u65b9\u53d1\u5e03\u7684\u6570\u5b57\u5316\u6bd5\u4e1a\u8bc1\uff0c\u90fd\u62e5\u6709\u552f\u4e00\u7684\u6570\u5b57\u6307\u7eb9\uff08Hash \u503c\uff09\u3002\u4efb\u4f55\u5bf9\u8bc1\u4e66\u6587\u672c\u3001\u59d3\u540d\u6216\u65e5\u671f\u7684\u5fae\u5c0f\u7be1\u6539\uff0c\u90fd\u4f1a\u5bfc\u81f4\u54c8\u5e0c\u503c\u5931\u6548\uff0c\u4ece\u800c\u5728\u9a8c\u8bc1\u7cfb\u7edf\u4e2d\u7ea2\u706f\u62a5\u8b66\u3002</li> <li>MyeQuals \u5b98\u65b9\u4e2d\u5fc3\u5316\u9a8c\u8bc1\uff1a \u8be5\u8bc1\u4e66\u4f9d\u6258\u4e8e\u53d7\u5bc6\u7801\u5b66\u4fdd\u62a4\u7684\u5b98\u65b9\u5e73\u53f0\u3002\u7b2c\u4e09\u65b9\u673a\u6784\uff08\u5982\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\u6216\u5168\u7403500\u5f3aHR\uff09\u65e0\u9700\u4f9d\u8d56\u7eb8\u8d28\u539f\u4ef6\uff0c\u53ea\u9700\u901a\u8fc7\u5b66\u751f\u5206\u4eab\u7684\u5b98\u65b9\u52a0\u5bc6\u94fe\u63a5\uff0c\u5373\u53ef\u76f4\u63a5\u8ffd\u6eaf\u81f3 ANU \u6570\u636e\u5e93\uff0c\u5b9e\u73b0\u79d2\u7ea7\u771f\u4f2a\u6838\u9a8c\u3002</li> </ul>"},{"location":"#_2","title":"\u56db\u3001 \u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u5bf9\u5168\u7403\u7559\u5b66\u751f\u7684\u6df1\u8fdc\u4ef7\u503c","text":""},{"location":"#1_1","title":"1. \u5f7b\u5e95\u544a\u522b\u201c\u5b66\u5386\u516c\u8bc1\u201d\u7684\u7e41\u7410\u6d41\u7a0b","text":"<p>\u5728\u8fc7\u53bb\uff0c\u6fb3\u6d32\u7559\u5b66\u751f\u56de\u56fd\u5c31\u4e1a\u6216\u524d\u5f80\u6b27\u7f8e\u6df1\u9020\uff0c\u9700\u8981\u7ecf\u5386\u6f2b\u957f\u7684\u516c\u8bc1\u3001\u7ffb\u8bd1\u548c\u53cc\u8ba4\u8bc1\u6d41\u7a0b\u3002\u800c\u91cd\u6784\u540e\u7684\u6570\u5b57\u5316 ANU \u6bd5\u4e1a\u8bc1\uff0c\u81ea\u5e26\u5168\u7403\u9a8c\u8bc1\u751f\u6001\u3002\u65e0\u8bba\u662f\u4e2d\u56fd\u7559\u670d\u4e2d\u5fc3\u7684\u8ba4\u8bc1\uff0c\u8fd8\u662f\u6d77\u5916\u9ad8\u7aef\u5c97\u4f4d\u7684\u80cc\u666f\u8c03\u67e5\uff0c\u5747\u53ef\u901a\u8fc7\u6570\u5b57\u5316\u94fe\u8def\u4e00\u952e\u5b8c\u6210\uff0c\u5927\u5e45\u63d0\u5347\u4e86\u5e74\u8f7b\u5b66\u5b50\u7684\u6c42\u804c\u6548\u7387\u3002</p>"},{"location":"#2_2","title":"2. \u7eff\u8272\u73af\u4fdd\u4e0e\u6c38\u4e0d\u4e22\u5931\u7684\u5b66\u672f\u8d44\u4ea7","text":"<p>\u6570\u5b57\u539f\u751f\u8bc1\u4e66\u4e0d\u4ec5\u54cd\u5e94\u4e86\u5168\u7403\u51cf\u78b3\u548c\u7eff\u8272\u6821\u56ed\uff08Green Campus\uff09\u7684\u73af\u4fdd\u5021\u8bae\uff0c\u66f4\u8d4b\u4e88\u4e86\u6bd5\u4e1a\u751f\u4e00\u4efd\u201c\u6c38\u4e0d\u78e8\u635f\u3001\u6c38\u4e45\u5728\u7ebf\u201d\u7684\u7ec8\u8eab\u5b66\u672f\u8d44\u4ea7\u3002\u54ea\u6015\u5386\u7ecf\u6570\u5341\u5e74\uff0c\u5b83\u4f9d\u7136\u80fd\u4ee5\u6700\u5b8c\u7f8e\u7684\u6570\u5b57\u7248\u5f0f\uff0c\u5448\u73b0\u5728\u4efb\u4f55\u9700\u8981\u5b83\u7684\u5730\u65b9\u3002</p>"},{"location":"#_3","title":"\u4e94\u3001 \u603b\u7ed3\u4e0e\u672a\u6765\u5c55\u671b","text":"<p>\u6fb3\u6d32\u56fd\u7acb\u5927\u5b66\uff08ANU\uff09\u6bd5\u4e1a\u8bc1\u7684\u6570\u5b57\u5316\u751f\u6001\u7248\u5f0f\u91cd\u6784\uff0c\u7edd\u975e\u7b80\u5355\u7684\u4ecb\u8d28\u8fc1\u79fb\uff0c\u800c\u662f\u4e00\u6b21\u5bf9\u9ad8\u7b49\u6559\u80b2\u4fe1\u4efb\u673a\u5236\u7684\u91cd\u5927\u5347\u534e\u3002\u5b83\u5c06\u4f20\u7edf\u7684\u5b66\u672f\u8363\u8a89\u878d\u5165\u5230\u4e86\u9ad8\u6548\u7387\u3001\u9ad8\u5b89\u5168\u3001\u53ef\u4e92\u64cd\u4f5c\u7684\u5168\u7403\u6570\u5b57\u7f51\u7edc\u4e2d\uff0c\u771f\u6b63\u505a\u5230\u4e86\u201c\u7248\u5f0f\u6781\u7b80\u3001\u5185\u6db5\u6781\u6df1\u201d\u3002</p> <p>\u968f\u7740\u533a\u5757\u94fe\u6280\u672f\u4e0e\u53ef\u9a8c\u8bc1\u51ed\u8bc1\uff08Verifiable Credentials\uff09\u7684\u8fdb\u4e00\u6b65\u53d1\u5c55\uff0c\u672a\u6765\u7684 ANU \u6570\u5b57\u5316\u8bc1\u4e66\u751a\u81f3\u53ef\u80fd\u8fdb\u5316\u4e3a\u52a8\u6001\u7684\u6570\u5b57\u52cb\u7ae0\u3002\u4f46\u65e0\u8bba\u6280\u672f\u5982\u4f55\u6f14\u53d8\uff0cANU \u6b64\u6b21\u5728\u7248\u5f0f\u91cd\u6784\u4e0a\u5c55\u73b0\u51fa\u7684\u524d\u77bb\u6027\u7f8e\u5b66\u4e0e\u5b89\u5168\u903b\u8f91\uff0c\u90fd\u5df2\u4e3a\u5168\u7403\u9ad8\u7b49\u9662\u6821\u7684\u6570\u5b57\u5316\u8f6c\u578b\u6811\u7acb\u4e86\u96be\u4ee5\u903e\u8d8a\u7684\u6807\u6746\u3002</p>"}]}